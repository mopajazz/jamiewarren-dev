---
import '../styles/global.css';
const {
  title = 'Jamie Warren',
  description = 'Instructional designer and developer — SCORM pipelines, Canvas rebuilds, and interactive learning tools.',
  image = '/og-default.png',
  type = 'website',
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const ogImage = new URL(image, Astro.site);
// Dimensions are only declared for the generated card, whose size we control.
// Per-page artifact images vary, and wrong hints cause bad preview crops.
const isDefaultCard = image === '/og-default.png';
const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/lab/', label: 'Lab' },
  { href: '/about/', label: 'About' },
];
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jamie Warren',
  url: Astro.site?.href,
  image: new URL('/jamie-warren-about.jpg', Astro.site).href,
  jobTitle: 'Instructional Designer & Learning Technologist',
  description,
  email: 'mailto:mopajazz@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Brevard', addressRegion: 'NC', addressCountry: 'US' },
  knowsAbout: ['Instructional design', 'SCORM', 'Canvas LMS', 'QTI', 'Articulate Storyline', 'Rise 360', 'Web audio', 'Accessibility'],
  sameAs: [
    'https://www.linkedin.com/in/jamie-warren-bb9b2a171/',
    'https://github.com/mopajazz',
    'https://jazzinteractive.org',
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <script is:inline>
    // Blocking and inline (is:inline stops Astro from bundling/deferring it)
    // so the stored theme is set on <html> before first paint — otherwise
    // a returning visitor who chose light against a dark OS sees one dark
    // frame before this would run.
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical.href} />
  <meta name="theme-color" content="#231f17" />

  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Jamie Warren" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical.href} />
  <meta property="og:image" content={ogImage.href} />
  {isDefaultCard && <meta property="og:image:width" content="1200" />}
  {isDefaultCard && <meta property="og:image:height" content="630" />}
  <meta property="og:locale" content="en_US" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage.href} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(person)} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site">
    <div class="wrap">
      <a class="brand" href="/">JAMIE_WARREN</a>
      <div class="header-right">
        <nav class="main" aria-label="Primary">
          {nav.map(n => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode" aria-pressed="false">
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site">
    <div class="wrap">
      <span>© {new Date().getFullYear()} Jamie Warren · Brevard, NC</span>
      <span>
        <a href="/Jamie-Warren-Resume.pdf">Resume (PDF)</a> ·
        <a href="mailto:mopajazz@gmail.com">Email</a> ·
        <a href="https://www.linkedin.com/in/jamie-warren-bb9b2a171/">LinkedIn</a> ·
        <a href="https://jazzinteractive.org">Jazz Interactive</a>
      </span>
    </div>
  </footer>
  <script is:inline>
    (function () {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      var mq = window.matchMedia('(prefers-color-scheme: dark)');
      function effectiveTheme() {
        var explicit = document.documentElement.getAttribute('data-theme');
        return explicit === 'dark' || explicit === 'light' ? explicit : (mq.matches ? 'dark' : 'light');
      }
      function reflect() {
        btn.setAttribute('aria-pressed', String(effectiveTheme() === 'dark'));
      }
      reflect();
      // Keeps aria-pressed accurate if the OS theme changes mid-visit and
      // the visitor hasn't overridden it via this button yet.
      mq.addEventListener('change', function () {
        if (!document.documentElement.hasAttribute('data-theme')) reflect();
      });
      btn.addEventListener('click', function () {
        var next = effectiveTheme() === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
        reflect();
      });
    })();
  </script>
</body>
</html>
